{
    "name": "daryl/wp-migration-assistant",
    "description": "WordPress site migration tool with hosting provider profiles",
    "type": "project",
    "version": "1.0.0",
    "authors": [
        {
            "name": "Daryl Lundy",
            "email": "daryl.lundy@gmail.com"
        }
    ],
    "require": {
        "php": ">=7.4",
        "symfony/console": "^6.0",
        "symfony/filesystem": "^6.0",
        "symfony/process": "^6.0",
        "doctrine/dbal": "^3.0",
        "guzzlehttp/guzzle": "^7.0",
        "vlucas/phpdotenv": "^5.0",
        "league/flysystem": "^3.0",
        "spatie/db-dumper": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "squizlabs/php_codesniffer": "^3.0",
        "phpstan/phpstan": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "WPMigration\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WPMigration\\Tests\\": "tests/"
        }
    },
    "bin": [
        "wp-migrate"
    ],
    "scripts": {
        "test": "phpunit",
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "analyse": "phpstan analyse"
    }
}
