# WP Migration Assistant Configuration
# Copy this file to .env and customize for your environment

# ===========================================
# Database Configuration (Source defaults)
# ===========================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=wordpress
DB_USER=root
DB_PASSWORD=

# ===========================================
# Path Configuration
# ===========================================
# Base path for WordPress installations (optional)
WP_BASE_PATH=/var/www/html

# Backup storage location (relative to project root)
BACKUP_PATH=var/backups

# Log storage location (relative to project root)
LOG_PATH=var/logs

# SSL certificates location (relative to project root)
CERT_PATH=var/certs

# ===========================================
# SSL Configuration
# ===========================================
# Let's Encrypt email for certificate registration
LETSENCRYPT_EMAIL=admin@example.com

# SSL staging mode (set to "true" for testing with LE staging servers)
SSL_STAGING=false

# ===========================================
# DNS Configuration
# ===========================================
# Default TTL for DNS records (in seconds)
DNS_DEFAULT_TTL=3600

# ===========================================
# Provider API Keys
# ===========================================
# Pressable API key (from your Pressable dashboard)
PRESSABLE_API_KEY=

# Kinsta API key (from your Kinsta dashboard)
KINSTA_API_KEY=

# GoDaddy API credentials
GODADDY_API_KEY=
GODADDY_API_SECRET=

# InMotion API credentials
INMOTION_API_KEY=

# ===========================================
# CDN Configuration
# ===========================================
# Cloudflare credentials (for CDN integration)
CLOUDFLARE_EMAIL=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ZONE_ID=

# ===========================================
# Webhook Configuration
# ===========================================
# Default webhook URL for migration events
WEBHOOK_URL=

# Webhook secret for signature verification
WEBHOOK_SECRET=

# ===========================================
# Migration Settings
# ===========================================
# Default chunk size for incremental migrations (in MB)
CHUNK_SIZE_MB=100

# Enable verbose logging
VERBOSE_LOGGING=false

# Maximum concurrent file transfers
MAX_CONCURRENT_TRANSFERS=5

# Timeout for remote operations (in seconds)
REMOTE_TIMEOUT=300
